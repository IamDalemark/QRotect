# Copy to .env.local and supply your Supabase project values.
# Sample browsing works without them; administrator features require both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put privileged Supabase secret/service-role keys in NEXT_PUBLIC_ variables.

# Stable application origin for authentication recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
