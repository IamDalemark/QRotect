# Copy to .env.local and supply your Supabase project values.
# Sample browsing works without them; administrator features require both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put privileged Supabase secret/service-role keys in NEXT_PUBLIC_ variables.

# Stable application origin for authentication recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database scripts: split hosted PostgreSQL/session-pooler connection.
# Copy your actual host and user from Supabase -> Connect -> Session pooler.
# These are server-only. A nonempty QROTECT_HOSTED_DATABASE_URL takes precedence.
QROTECT_HOSTED_DB_HOST=
QROTECT_HOSTED_DB_PORT=5432
QROTECT_HOSTED_DB_NAME=postgres
QROTECT_HOSTED_DB_USER=
QROTECT_HOSTED_DB_PASSWORD=

# Defaults for pnpm db:reset and pnpm db:populate (local or hosted).
QROTECT_DB_TARGET=hosted
QROTECT_POPULATE_FILE=./directory.json
# Population requires an active administrator UUID for publication attribution.
QROTECT_ADMIN_USER_ID=
