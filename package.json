{
  "name": "qrotect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:browser",
    "test:db": "tsx scripts/check-database.mts && tsx scripts/check-quick-calls.mts && tsx scripts/check-relational-directory.mts && tsx scripts/check-item-publishing.mts",
    "test:migration": "tsx scripts/check-relational-migration.mts",
    "test:browser": "tsx scripts/run-browser-checks.mts",
    "setup:local": "tsx scripts/setup-local.mts",
    "review:sample": "tsx scripts/preview-sample.mts",
    "qr": "tsx scripts/generate-qr.mts",
    "review:admin": "tsx scripts/preview-admin.mts",
    "supabase:check": "tsx scripts/check-supabase.mts",
    "supabase:prepare": "tsx scripts/prepare-supabase.mts",
    "seed:demo": "tsx scripts/seed-demo-contacts.mts",
    "analyze": "ANALYZE=true pnpm build",
    "perf:mobile": "tsx scripts/measure-performance.mts"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.21",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "qrcode": "1.5.4",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.23.2 <23"
  }
}
