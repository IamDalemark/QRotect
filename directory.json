  "guidance": [
    {
      "id": "40000000-0000-4000-8000-000000000001",
      "category": "police",
      "title": {
        "en": "Contacting a police assistance desk",
        "hil": "Pagkontak sa desko sang pulis"
      },
      "steps": [
        {
          "en": "Open the contact card and check the agency and service area.",
          "hil": "Abrihi ang kard sang kontak kag tan-awa ang ahensya kag lugar nga ginserbisyuhan."
        },
        {
          "en": "Have the location and a short description of your concern ready.",
          "hil": "Ihanda ang lokasyon kag malip-ot nga paglaragway sang imo kabalak-an."
        },
        {
          "en": "Use the voice line for a call or the text line for a text message.",
          "hil": "Gamita ang linya para sa tawag ukon ang linya para sa text suno sa imo kinahanglanon."
        }
      ],
      "source": "https://example.com/guidance/police",
      "reviewedAt": "2026-11-18",
      "reviewer": "Demo content review",
      "approved": true
    },
    {
      "id": "40000000-0000-4000-8000-000000000002",
      "category": "fire",
      "title": {
        "en": "Finding fire-service contacts",
        "hil": "Pagpangita sang kontak sang serbisyo sa sunog"
      },
      "steps": [
        {
          "en": "Choose Fire in the contact directory.",
          "hil": "Pilia ang Sunog sa listahan sang mga kontak."
        },
        {
          "en": "Check the contact description and service area before calling.",
          "hil": "Tan-awa ang paglaragway sang kontak kag lugar nga ginserbisyuhan antes magtawag."
        },
        {
          "en": "State the location clearly when speaking with the operator.",
          "hil": "Isugid sing maathag ang lokasyon kon makighambal sa operator."
        }
      ],
      "source": "https://example.com/guidance/fire",
      "reviewedAt": "2026-11-18",
      "reviewer": "Demo content review",
      "approved": true
    },
    {
      "id": "40000000-0000-4000-8000-000000000003",
      "category": "medical",
      "title": {
        "en": "Asking about medical transport",
        "hil": "Pagpamangkot parte sa transportasyon medikal"
      },
      "steps": [
        {
          "en": "Choose Medical / Ambulance and open the relevant contact.",
          "hil": "Pilia ang Medikal / Ambulansya kag abrihi ang nagakaigo nga kontak."
        },
        {
          "en": "Prepare the pickup location and a callback number.",
          "hil": "Ihanda ang lugar sang pagsundo kag numero nga matawgan liwat."
        },
        {
          "en": "Ask the operator about available services; the website does not dispatch a vehicle.",
          "hil": "Pamangkuta ang operator parte sa magamit nga serbisyo; ang website wala nagapadala sang salakyan."
        }
      ],
      "source": "https://example.com/guidance/medical",
      "reviewedAt": "2026-11-18",
      "reviewer": "Demo content review",
      "approved": true
    },
    {
      "id": "40000000-0000-4000-8000-000000000004",
      "category": "hospital",
      "title": {
        "en": "Finding hospital information",
        "hil": "Pagpangita sang impormasyon sang ospital"
      },
      "steps": [
        {
          "en": "Choose Hospitals and review the listed departments and contact labels.",
          "hil": "Pilia ang Mga ospital kag tan-awa ang nakalista nga mga departamento kag ngalan sang linya."
        },
        {
          "en": "Use the office information line for department or admissions questions.",
          "hil": "Gamita ang linya sang impormasyon sang opisina para sa pamangkot parte sa departamento ukon pag-admit."
        },
        {
          "en": "Confirm schedules and service availability directly with the hospital.",
          "hil": "Kumpirmaha mismo sa ospital ang iskedyul kag kon may ara sang kinahanglan nga serbisyo."
        }
      ],
      "source": "https://example.com/guidance/hospital",
      "reviewedAt": "2026-11-18",
